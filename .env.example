# Copy this file to .env.local and fill in your values.
# Find them at: https://supabase.com/dashboard/project/_/settings/api

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Canonical public site URL for share links and email redirects.
# Localhost values are ignored; the app falls back to https://www.themeritt.com.
VITE_SITE_URL=https://www.themeritt.com

# Legacy Next.js names still supported via vite envPrefix:
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SITE_URL=

# Optional — wire a vendor adapter in src/instrumentation.ts
# ERROR_REPORTING_DSN=

# Node environment (set automatically in most hosts)
# NODE_ENV=production

# Required for `npm run db:migrate` — from Supabase Dashboard → Connect → Session pooler → URI
# (Use Session pooler, not Direct connection, if db.[ref].supabase.co gives ENOTFOUND on your network.)
# SUPABASE_DB_URL=postgresql://postgres.[ref]:[YOUR-PASSWORD]@aws-1-[region].pooler.supabase.com:5432/postgres

# Required for `npm run badges:compute` — from Supabase Dashboard → Project Settings → API → service_role
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
